; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="ChronoRift Game"
config/description="2.5D Isometric Adventure + Farming + Base-building with Time Manipulation"
config/version="0.1.0"
run/main_scene="uid://bp0qu5aa4473m"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoloads/EventBus.gd"
GameManager="*res://autoloads/GameManager.gd"
DataManager="*res://autoloads/DataManager.gd"
ResourceManager="*res://scripts/autoloads/resource_manager.gd"
LootSystem="*uid://cs0bebifwh8ck"
EffectManager="*res://scripts/effects/effect_manager.gd"
Player_Inventory="*res://scripts/player/player_inventory.gd"
Building_System="*res://scripts/systems/building_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="viewport"

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

